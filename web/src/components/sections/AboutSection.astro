---
import { PortableText } from 'astro-portabletext';
import type { PROFILE_QUERY_RESULT, SkillItem } from '../../lib/sanity';

interface SkillCategory {
	key: string;
	label: string;
}

interface Props {
	profile?: PROFILE_QUERY_RESULT;
	skills: SkillItem[];
	skillCategories: SkillCategory[];
}

const { profile, skills, skillCategories } = Astro.props;
---

<!-- Panel 04: Technical Architecture & Stack -->
<section id="about" class="horizontal-panel" data-panel-index="3" data-panel-title="About">
	<div class="panel-inner">
		<div class="editorial-section">
			<div class="section-topbar">
				<span class="section-kicker">TECHNICAL CAPABILITIES</span>
				<h2 class="section-title">About &amp; Stack</h2>
			</div>

			<div class="about-grid">
				<div class="about-prose">
					{profile?.bio ? (
						<PortableText value={profile.bio} />
					) : (
						<p>
							I'm a full-stack web developer who combines solid server-side logic with polished frontend experiences.
							I specialize in scalable backend systems, Linux servers, and end-to-end web deployment.
						</p>
					)}
				</div>

				<div class="about-aside">
					<h3 class="aside-heading">Technical Skills &amp; Stack</h3>
					{skills && skills.length > 0 ? (
						<div class="skills-grid">
							{skillCategories.map((cat) => {
								const catSkills = skills.filter((s) => s.category?.toLowerCase() === cat.key);
								if (catSkills.length === 0) return null;
								return (
									<div class="skill-group">
										<span class="skill-group-label">{cat.label}</span>
										<div class="skill-group-pills">
											{catSkills.map((s) => (
												<span class="skill-pill" title={s.level ? `Level: ${s.level}` : undefined}>
													{s.name}
												</span>
											))}
										</div>
									</div>
								);
							})}
						</div>
					) : (
						<ul class="aside-list">
							<li>
								<strong>System Architecture</strong>
								<span>Designing data contracts, RESTful interfaces, and modular backend services.</span>
							</li>
							<li>
								<strong>Linux &amp; Server Infrastructure</strong>
								<span>Server security, Docker container orchestration, deployment automation, and process monitoring.</span>
							</li>
							<li>
								<strong>Database Engineering</strong>
								<span>Relational data modeling with PostgreSQL, indexing, query optimization, and cache management.</span>
							</li>
							<li>
								<strong>Full-Stack Frontend</strong>
								<span>Next.js, Tailwind CSS, and TypeScript for responsive, accessible user interfaces.</span>
							</li>
						</ul>
					)}
				</div>
			</div>
		</div>
	</div>
</section>
