---
import '../styles/global.css';
import { PortableText } from 'astro-portabletext';
import Icon from '../components/Icon.astro';
import {
	formatMonthYear,
	getExperiences,
	getProfile,
	getProjects,
	getSkills,
	imageUrl,
} from '../lib/sanity';

const [profile, projects, experiences, skills] = await Promise.all([
	getProfile(),
	getProjects(),
	getExperiences(),
	getSkills(),
]);

const name = profile?.name ?? 'Redho Arifin';
const nick = profile?.nickname ?? 'Redo';
const role = profile?.role ?? 'Backend Developer';
const year = new Date().getFullYear();

// Avatar URL directly from Sanity asset, falling back to local /avatar.jpg
const avatarUrl = imageUrl(profile?.avatar, 440) ?? '/avatar.jpg';

// Skill categories for the About & Skills section
const skillCategories = [
	{ key: 'backend', label: 'Backend' },
	{ key: 'database', label: 'Database' },
	{ key: 'devops', label: 'DevOps & Systems' },
	{ key: 'frontend', label: 'Frontend' },
	{ key: 'mobile', label: 'Mobile' },
];

const visitorNo = String(
	(1337 + [...name + nick + role].reduce((sum, c) => sum + c.charCodeAt(0), 0)) % 100000,
).padStart(6, '0');

// Unique tags across all projects
const allTags = Array.from(
	new Set(projects.flatMap((p) => p.tags ?? []).filter(Boolean)),
).sort();

const getDomain = (url: string | null | undefined) => {
	if (!url) return 'system.internal';
	try {
		return new URL(url).hostname;
	} catch {
		return 'system.internal';
	}
};
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content={`${name} — ${role}. ${profile?.tagline ?? 'Building fast, secure, and easy-to-use web applications.'}`.trim()}
		/>
		<meta property="og:title" content={`${name} — ${role}`} />
		<meta property="og:description" content={profile?.tagline ?? 'Building fast, secure, and easy-to-use web applications.'} />

		<!-- Prevent Flash of Unstyled Theme -->
		<script is:inline>
			const storedTheme = localStorage.getItem('theme');
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const theme = storedTheme || (prefersDark ? 'dark' : 'light');
			document.documentElement.setAttribute('data-theme', theme);
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{`${name} — ${role}`}</title>
	</head>

	<body>
		<div class="site-viewport">
			<!-- Header / Top Navigation -->
			<header class="top-nav">
				<div class="nav-wrapper">
					<a href="#profile" class="brand" data-nav-index="0" title="Go to Profile">
						<img
							src={avatarUrl}
							alt={`Avatar of ${name}`}
							class="brand-avatar"
							width="34"
							height="34"
						/>
						<div class="brand-text">
							<span class="brand-title">{name}</span>
							<span class="brand-sub">{role} · {profile?.location ?? 'Surabaya, ID'}</span>
						</div>
					</a>

					<div class="nav-controls">
						<nav class="nav-menu" id="mainNavMenu" aria-label="Page Sections">
							<button type="button" class="nav-anchor active" data-nav-index="0" data-nav-target="profile">
								Profile
							</button>
							<button type="button" class="nav-anchor" data-nav-index="1" data-nav-target="projects">
								Works
							</button>
							<button type="button" class="nav-anchor" data-nav-index="2" data-nav-target="experience">
								Experience
							</button>
							<button type="button" class="nav-anchor" data-nav-index="3" data-nav-target="about">
								About
							</button>
							<button type="button" class="nav-anchor" data-nav-index="4" data-nav-target="contact">
								Contact
							</button>
						</nav>

						<!-- Theme Switcher -->
						<button
							type="button"
							id="themeToggle"
							class="theme-toggle"
							aria-label="Toggle dark / light theme"
							title="Toggle theme"
						>
							<span class="theme-icon sun"><Icon name="sun" size={15} /></span>
							<span class="theme-icon moon"><Icon name="moon" size={15} /></span>
						</button>
					</div>
				</div>
			</header>

			<!-- Horizontal Viewport Slider -->
			<main class="horizontal-slider" id="horizontalSlider">
				<div class="panels-track" id="panelsTrack">
					<!-- Panel 01: Profile -->
					<section id="profile" class="horizontal-panel" data-panel-index="0" data-panel-title="Profile">
						<div class="panel-inner">
							<div class="editorial-hero">
								<div class="hero-split">
									<div class="hero-statement">
										<span class="section-kicker">PROFILE · BACKEND ENGINEER</span>
										<h1 class="statement-headline">
											{profile?.tagline ?? 'Building fast, secure, and easy-to-use web applications.'}
										</h1>
										<div class="statement-sub">
											{profile?.bio ? (
												<PortableText value={profile.bio} />
											) : (
												<p>
													I'm a full-stack web developer who combines solid server-side logic with polished frontend experiences.
													I specialize in scalable backend systems — from relational and NoSQL database design to RESTful APIs and data security.
												</p>
											)}
										</div>

										<div class="hero-connect-row">
											{profile?.email && (
												<a href={`mailto:${profile.email}`} class="hero-cta-btn">
													<Icon name="mail" size={14} />
													<span>Email</span>
												</a>
											)}
											{profile?.socials?.map((s) => (
												<a href={s.url ?? '#'} target="_blank" rel="noreferrer" class="hero-social-link">
													{s.label === 'GitHub' ? <Icon name="github" size={13} /> : s.label === 'LinkedIn' ? <Icon name="linkedin" size={13} /> : null}
													<span>{s.label} ↗</span>
												</a>
											))}
											<button type="button" class="hero-action-next" data-nav-index="1">
												<span>View Works →</span>
											</button>
										</div>
									</div>

									<div class="hero-portrait">
										<div class="portrait-frame">
											<img
												src={avatarUrl}
												alt={`Photo of ${name}`}
												class="portrait-img"
												width="200"
												height="200"
												loading="eager"
											/>
										</div>
										<div class="portrait-meta">
											<span class="portrait-name">{name}</span>
											<span class="portrait-handle">@{nick.toLowerCase()}amain</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</section>

					<!-- Panel 02: Selected Works -->
					<section id="projects" class="horizontal-panel" data-panel-index="1" data-panel-title="Works">
						<div class="panel-inner">
							<div class="editorial-section works-section-wrap">
								<div class="section-topbar">
									<div class="topbar-header-row">
										<div class="topbar-left">
											<span class="section-kicker">SELECTED WORKS</span>
											<div class="title-with-count">
												<h2 class="section-title">Projects &amp; Systems</h2>
												<span class="section-count">({projects.length})</span>
											</div>
										</div>

										<div class="topbar-controls">
											<!-- Search Input -->
											<div class="project-search-wrap">
												<Icon name="search" size={13} />
												<input
													type="text"
													id="projectSearch"
													class="project-search-input"
													placeholder="Search project or stack..."
													aria-label="Search projects by title or technology"
												/>
											</div>

											<!-- View Mode Toggle -->
											<div class="view-toggle-group" role="group" aria-label="Project view mode">
												<button
													type="button"
													id="btnViewShowcase"
													class="view-btn active"
													aria-pressed="true"
													title="Showcase Cards View"
												>
													<Icon name="grid" size={13} />
													<span>Showcase</span>
												</button>
												<button
													type="button"
													id="btnViewTable"
													class="view-btn"
													aria-pressed="false"
													title="All Projects Table View"
												>
													<Icon name="list" size={13} />
													<span>Index Table</span>
												</button>
											</div>
										</div>
									</div>

									{/* Tag Filter Pills */}
									{allTags.length > 0 && (
										<div class="filter-capsules" role="tablist" aria-label="Filter works by technology">
											<button type="button" class="filter-btn active" data-filter="all" aria-pressed="true">
												All
											</button>
											{allTags.map((tag) => (
												<button type="button" class="filter-btn" data-filter={tag} aria-pressed="false">
													{tag}
												</button>
											))}
										</div>
									)}
								</div>

								<!-- 1. Editorial Showcase View -->
								<div class="works-showcase-view" id="worksShowcase">
									{projects.map((p, idx) => (
										<article
											class={`work-card ${idx >= 4 ? 'work-extra' : ''}`}
											data-tags={(p.tags ?? []).join(',')}
											data-title={(p.title ?? '').toLowerCase()}
											data-id={p._id}
										>
											<div class="work-card-info">
												<span class="work-kicker">0{idx + 1} · System Architecture</span>
												<h3 class="work-name">
													<button
														type="button"
														class="work-title-link"
														data-open-modal={`modal-${p._id}`}
														aria-label={`View details for ${p.title}`}
													>
														{p.title}
													</button>
												</h3>
												{p.summary && <p class="work-desc">{p.summary}</p>}

												{p.tags && p.tags.length > 0 && (
													<div class="work-tags-row">
														{p.tags.map((t) => (
															<span class="spec-tag">{t}</span>
														))}
													</div>
												)}

												<div class="work-actions">
													{p.liveUrl && (
														<a href={p.liveUrl} target="_blank" rel="noreferrer" class="action-link-btn">
															<span>Live</span>
															<Icon name="arrow-up-right" size={13} />
														</a>
													)}
													{p.repoUrl && (
														<a href={p.repoUrl} target="_blank" rel="noreferrer" class="action-link-btn">
															<span>Source</span>
															<Icon name="arrow-up-right" size={13} />
														</a>
													)}
													<button
														type="button"
														class="action-link-btn details-btn"
														data-open-modal={`modal-${p._id}`}
													>
														<span>Overview</span>
														<Icon name="info" size={13} />
													</button>
												</div>
											</div>

											<div class="work-card-preview">
												<div class="browser-mockup" data-open-modal={`modal-${p._id}`} role="button" tabindex="0" title={`Click to view overview for ${p.title}`}>
													<div class="browser-bar">
														<div class="browser-dots">
															<span class="browser-dot"></span>
															<span class="browser-dot"></span>
															<span class="browser-dot"></span>
														</div>
														<span class="browser-url">{getDomain(p.liveUrl ?? p.repoUrl)}</span>
													</div>
													<div class="browser-content">
														{p.coverImage?.asset ? (
															<img
																src={imageUrl(p.coverImage, 900) ?? ''}
																alt={p.title ?? 'Project view'}
																loading="lazy"
																class="browser-img"
															/>
														) : (
															<div class="schematic-preview">
																<div class="schematic-top">
																	<Icon name="terminal" size={13} />
																	<span>ENGINEERING ARCHITECTURE</span>
																</div>
																<div class="schematic-body">
																	<span class="schematic-title">{p.title}</span>
																	<span class="schematic-stack">{(p.tags ?? []).slice(0, 4).join(' · ')}</span>
																</div>
																<div class="schematic-footer">
																	<span>READY FOR PRODUCTION</span>
																</div>
															</div>
														)}
													</div>
												</div>
											</div>
										</article>
									))}
								</div>

								<!-- Load More Button (Showcase View) -->
								{projects.length > 4 && (
									<div class="load-more-wrap" id="loadMoreWrap">
										<button type="button" id="loadMoreBtn" class="load-more-btn">
											<span id="loadMoreLabel">Show all {projects.length} projects</span>
											<Icon name="chevron-down" size={13} />
										</button>
									</div>
								)}

								<!-- 2. Table Index View (Archive for large number of projects) -->
								<div class="works-table-view" id="worksTableView" style="display: none;">
									<table class="works-table">
										<thead>
											<tr>
												<th>No.</th>
												<th>Project</th>
												<th>Technologies</th>
												<th>Actions</th>
											</tr>
										</thead>
										<tbody>
											{projects.map((p, idx) => (
												<tr
													class="table-row-item"
													data-tags={(p.tags ?? []).join(',')}
													data-title={(p.title ?? '').toLowerCase()}
												>
													<td class="table-index">0{idx + 1}</td>
													<td>
														<div class="table-proj-info">
															<button
																type="button"
																class="table-proj-name"
																data-open-modal={`modal-${p._id}`}
															>
																{p.title}
															</button>
															{p.summary && <span class="table-proj-summary">{p.summary}</span>}
														</div>
													</td>
													<td>
														<div class="work-tags-row">
															{(p.tags ?? []).slice(0, 4).map((t) => (
																<span class="spec-tag">{t}</span>
															))}
														</div>
													</td>
													<td>
														<div class="table-actions">
															{p.liveUrl && (
																<a href={p.liveUrl} target="_blank" rel="noreferrer" class="action-link-btn" title="Live Preview">
																	<span>Live</span>
																	<Icon name="arrow-up-right" size={11} />
																</a>
															)}
															{p.repoUrl && (
																<a href={p.repoUrl} target="_blank" rel="noreferrer" class="action-link-btn" title="Source Code">
																	<span>Repo</span>
																	<Icon name="arrow-up-right" size={11} />
																</a>
															)}
															<button
																type="button"
																class="action-link-btn"
																data-open-modal={`modal-${p._id}`}
																title="Project Details"
															>
																<span>Details</span>
															</button>
														</div>
													</td>
												</tr>
											))}
										</tbody>
									</table>
								</div>

								<!-- Filter empty state -->
								<div id="noResultsMsg" class="editorial-empty" style="display: none;">
									<p>No projects match your search or filter.</p>
									<button type="button" class="action-link" id="resetFilter">Clear filters →</button>
								</div>
							</div>
						</div>
					</section>

					<!-- Panel 03: Experience & Roles -->
					<section id="experience" class="horizontal-panel" data-panel-index="2" data-panel-title="Experience">
						<div class="panel-inner">
							<div class="editorial-section">
								<div class="section-topbar">
									<span class="section-kicker">CAREER &amp; EXPERIENCE</span>
									<h2 class="section-title">Experience &amp; Roles</h2>
								</div>

								<div class="experience-table">
									{experiences.map((e) => (
										<div class="exp-row">
											<div class="exp-col-date">
												<span class="exp-time">
													{formatMonthYear(e.startDate)} — {e.current ? 'Present' : formatMonthYear(e.endDate)}
												</span>
												{e.location && <span class="exp-loc">{e.location}</span>}
											</div>

											<div class="exp-col-role">
												<h3 class="exp-position">{e.position}</h3>
												<span class="exp-company">@ {e.company}</span>
											</div>

											<div class="exp-col-summary">
												{e.summary && <p>{e.summary}</p>}
												{e.tags && e.tags.length > 0 && (
													<div class="exp-tags-list">
														{e.tags.map((t) => (
															<span class="spec-tag">{t}</span>
														))}
													</div>
												)}
											</div>
										</div>
									))}
								</div>
							</div>
						</div>
					</section>

					<!-- Panel 04: Technical Architecture & Stack -->
					<section id="about" class="horizontal-panel" data-panel-index="3" data-panel-title="About">
						<div class="panel-inner">
							<div class="editorial-section">
								<div class="section-topbar">
									<span class="section-kicker">TECHNICAL CAPABILITIES</span>
									<h2 class="section-title">About &amp; Stack</h2>
								</div>

								<div class="about-grid">
									<div class="about-prose">
										{profile?.bio ? (
											<PortableText value={profile.bio} />
										) : (
											<p>
												I'm a full-stack web developer who combines solid server-side logic with polished frontend experiences.
												I specialize in scalable backend systems, Linux servers, and end-to-end web deployment.
											</p>
										)}
									</div>

									<div class="about-aside">
										<h3 class="aside-heading">Technical Skills &amp; Stack</h3>
										{skills && skills.length > 0 ? (
											<div class="skills-grid">
												{skillCategories.map((cat) => {
													const catSkills = skills.filter((s) => s.category?.toLowerCase() === cat.key);
													if (catSkills.length === 0) return null;
													return (
														<div class="skill-group">
															<span class="skill-group-label">{cat.label}</span>
															<div class="skill-group-pills">
																{catSkills.map((s) => (
																	<span class="skill-pill" title={s.level ? `Level: ${s.level}` : undefined}>
																		{s.name}
																	</span>
																))}
															</div>
														</div>
													);
												})}
											</div>
										) : (
											<ul class="aside-list">
												<li>
													<strong>System Architecture</strong>
													<span>Designing data contracts, RESTful interfaces, and modular backend services.</span>
												</li>
												<li>
													<strong>Linux &amp; Server Infrastructure</strong>
													<span>Server security, Docker container orchestration, deployment automation, and process monitoring.</span>
												</li>
												<li>
													<strong>Database Engineering</strong>
													<span>Relational data modeling with PostgreSQL, indexing, query optimization, and cache management.</span>
												</li>
												<li>
													<strong>Full-Stack Frontend</strong>
													<span>Next.js, Tailwind CSS, and TypeScript for responsive, accessible user interfaces.</span>
												</li>
											</ul>
										)}
									</div>
								</div>
							</div>
						</div>
					</section>

					<!-- Panel 05: Contact & Colophon -->
					<section id="contact" class="horizontal-panel" data-panel-index="4" data-panel-title="Contact">
						<div class="panel-inner">
							<div class="editorial-section contact-section">
								<div class="section-topbar">
									<span class="section-kicker">TRANSMISSION &amp; CONNECT</span>
									<h2 class="section-title">Get in Touch</h2>
								</div>

								<div class="contact-box">
									<p class="contact-intro">
										If you have a backend infrastructure challenge, a project inquiry, or want to discuss technical collaboration, write directly:
									</p>

									{profile?.email && (
										<div class="contact-email-row">
											<a href={`mailto:${profile.email}`} class="big-email-link">
												{profile.email}
											</a>
											<button
												type="button"
												class="copy-btn"
												id="copyEmailBtn"
												data-email={profile.email}
												title="Copy email to clipboard"
											>
												<span id="copyStatus">Copy Address</span>
											</button>
										</div>
									)}

									{profile?.socials && profile.socials.length > 0 && (
										<div class="contact-social-row">
											<span class="social-caption">Elsewhere:</span>
											<div class="social-links-list">
												{profile.socials.map((s) => (
													<a href={s.url ?? '#'} target="_blank" rel="noreferrer" class="action-link">
														{s.label} ↗
													</a>
												))}
											</div>
										</div>
									)}
								</div>
							</div>

							<!-- In-panel colophon footer -->
							<div class="panel-footer-colophon">
								<div class="footer-wrapper">
									<div class="footer-col">
										<span>{name}</span>
										<span class="footer-dot">·</span>
										<span>© {year}</span>
									</div>
									<div class="footer-col">
										<span class="footer-quiet" id="visitorCounter">Visitor #{visitorNo}</span>
									</div>
									<div class="footer-col">
										<button type="button" class="back-start-btn" data-nav-index="0">Back to start (01) ↑</button>
									</div>
								</div>
							</div>
						</div>
					</section>
				</div>
			</main>

			<!-- Project Overview Modals (Dead-center in viewport) -->
			{projects.map((p) => (
				<dialog id={`modal-${p._id}`} class="editorial-dialog" aria-labelledby={`title-${p._id}`}>
					<div class="dialog-inner">
						<button type="button" class="dialog-close-corner" data-close-modal aria-label="Close overview" title="Close (Esc)">
							<Icon name="x" size={17} />
						</button>

						<div class="dialog-scroll">
							<!-- Centered Header -->
							<div class="dialog-header-center">
								<span class="dialog-kicker">CASE STUDY · PROJECT OVERVIEW</span>
								<h2 class="dialog-title" id={`title-${p._id}`}>{p.title}</h2>
								
								<!-- Quick action links -->
								<div class="dialog-quick-actions">
									{p.liveUrl && (
										<a href={p.liveUrl} target="_blank" rel="noreferrer" class="dialog-pill-link">
											<span>Visit Live Site</span>
											<Icon name="arrow-up-right" size={12} />
										</a>
									)}
									{p.repoUrl && (
										<a href={p.repoUrl} target="_blank" rel="noreferrer" class="dialog-pill-link">
											<span>Source Repository</span>
											<Icon name="arrow-up-right" size={12} />
										</a>
									)}
								</div>
							</div>

							<!-- Centered Media Frame -->
							{p.coverImage?.asset && (
								<div class="dialog-media-frame">
									<div class="browser-bar">
										<div class="browser-dots">
											<span class="browser-dot"></span>
											<span class="browser-dot"></span>
											<span class="browser-dot"></span>
										</div>
										<span class="browser-url">{getDomain(p.liveUrl ?? p.repoUrl)}</span>
									</div>
									<div class="dialog-img-wrap">
										<img
											src={imageUrl(p.coverImage, 1200) ?? ''}
											alt={p.title ?? 'Project full view'}
											class="dialog-cover-img"
											loading="lazy"
										/>
									</div>
								</div>
							)}

							<!-- Centered Summary Lead -->
							{p.summary && (
								<p class="dialog-lead-centered">{p.summary}</p>
							)}

							<!-- Centered Tech Tags -->
							{p.tags && p.tags.length > 0 && (
								<div class="dialog-spec-centered">
									{p.tags.map((t) => (
										<span class="spec-tag">{t}</span>
									))}
								</div>
							)}

							<!-- Subtle Center Divider -->
							<div class="dialog-divider"></div>

							<!-- Centered Reading Column -->
							{p.description && p.description.length > 0 && (
								<div class="dialog-body-prose">
									<PortableText value={p.description} />
								</div>
							)}

							<!-- Centered Action Buttons -->
							<div class="dialog-links-row">
								{p.liveUrl && (
									<a href={p.liveUrl} target="_blank" rel="noreferrer" class="button-solid">
										<span>Open Live Application</span>
										<Icon name="arrow-up-right" size={13} />
									</a>
								)}
								{p.repoUrl && (
									<a href={p.repoUrl} target="_blank" rel="noreferrer" class="button-outline">
										<span>View Source Code</span>
										<Icon name="arrow-up-right" size={13} />
									</a>
								)}
								<button type="button" class="button-ghost" data-close-modal>
									Close
								</button>
							</div>
						</div>
					</div>
				</dialog>
			))}
		</div>
	</body>
</html>

<script>
	// Dark / Light Theme Toggle
	const themeBtn = document.getElementById('themeToggle');
	if (themeBtn) {
		themeBtn.addEventListener('click', () => {
			const current = document.documentElement.getAttribute('data-theme') || 'dark';
			const next = current === 'dark' ? 'light' : 'dark';
			document.documentElement.setAttribute('data-theme', next);
			localStorage.setItem('theme', next);
		});
	}

	// Panel Navigation System (Horizontal Menu-Driven)
	const panelsTrack = document.getElementById('panelsTrack') as HTMLElement | null;
	const panels = document.querySelectorAll<HTMLElement>('.horizontal-panel');
	const navAnchors = document.querySelectorAll<HTMLElement>('.nav-anchor[data-nav-index]');
	let currentPanelIndex = 0;
	const totalPanels = panels.length;

	const goToPanel = (index: number, updateHash = true) => {
		if (index < 0 || index >= totalPanels) return;
		currentPanelIndex = index;

		// Move slider track horizontally
		if (panelsTrack) {
			panelsTrack.style.transform = `translateX(-${index * 100}vw)`;
		}

		// Update active state in top nav menu
		navAnchors.forEach((a) => {
			const idx = Number(a.dataset.navIndex);
			if (idx === index) {
				a.classList.add('active');
				a.setAttribute('aria-selected', 'true');
				a.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
			} else {
				a.classList.remove('active');
				a.setAttribute('aria-selected', 'false');
			}
		});

		// Update URL hash
		const activePanel = panels[index];
		if (activePanel && updateHash) {
			const targetId = activePanel.id;
			if (targetId) {
				history.replaceState(null, '', '#' + targetId);
			}
		}

		// Reset panel scroll to top when entered
		activePanel?.scrollTo({ top: 0, behavior: 'instant' });
	};

	// Event listeners for menu anchors
	navAnchors.forEach((btn) => {
		btn.addEventListener('click', (e) => {
			e.preventDefault();
			const idx = Number(btn.dataset.navIndex);
			goToPanel(idx);
		});
	});

	// Buttons inside panels that navigate to specific panels
	document.querySelectorAll<HTMLElement>('[data-nav-index]').forEach((el) => {
		if (el.classList.contains('nav-anchor')) return;
		el.addEventListener('click', (e) => {
			e.preventDefault();
			const idx = Number(el.dataset.navIndex);
			goToPanel(idx);
		});
	});

	// Support any link with href="#section" navigating to that panel
	document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
		link.addEventListener('click', (e) => {
			const href = link.getAttribute('href');
			if (!href || href === '#') return;
			const targetId = href.replace('#', '');
			const targetPanel = document.getElementById(targetId);
			if (targetPanel && targetPanel.classList.contains('horizontal-panel')) {
				e.preventDefault();
				const idx = Array.from(panels).indexOf(targetPanel);
				if (idx !== -1) {
					goToPanel(idx);
				}
			}
		});
	});

	// Keyboard arrow navigation
	window.addEventListener('keydown', (e) => {
		const isInput = ['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName);
		const hasOpenDialog = document.querySelector('dialog[open]');
		if (isInput || hasOpenDialog) return;

		if (e.key === 'ArrowRight') {
			goToPanel(currentPanelIndex + 1);
		} else if (e.key === 'ArrowLeft') {
			goToPanel(currentPanelIndex - 1);
		}
	});

	// Touch swipe navigation for mobile
	let touchStartX = 0;
	let touchStartY = 0;
	const slider = document.getElementById('horizontalSlider');
	if (slider) {
		slider.addEventListener('touchstart', (e) => {
			touchStartX = e.changedTouches[0].screenX;
			touchStartY = e.changedTouches[0].screenY;
		}, { passive: true });

		slider.addEventListener('touchend', (e) => {
			const touchEndX = e.changedTouches[0].screenX;
			const touchEndY = e.changedTouches[0].screenY;
			const diffX = touchStartX - touchEndX;
			const diffY = touchStartY - touchEndY;
			if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
				if (diffX > 0) {
					goToPanel(currentPanelIndex + 1);
				} else {
					goToPanel(currentPanelIndex - 1);
				}
			}
		}, { passive: true });
	}

	// Initialize based on URL hash on load
	const hash = window.location.hash.replace('#', '');
	if (hash) {
		const targetPanel = document.getElementById(hash);
		if (targetPanel && targetPanel.classList.contains('horizontal-panel')) {
			const idx = Array.from(panels).indexOf(targetPanel);
			if (idx !== -1) {
				goToPanel(idx, false);
			}
		}
	}

	// Project View State, Search, & Filtering
	const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const showcaseCards = document.querySelectorAll<HTMLElement>('.work-card');
	const tableRows = document.querySelectorAll<HTMLElement>('.table-row-item');
	const noResults = document.getElementById('noResultsMsg');
	const resetBtn = document.getElementById('resetFilter');
	const searchInput = document.getElementById('projectSearch') as HTMLInputElement | null;
	const btnViewShowcase = document.getElementById('btnViewShowcase');
	const btnViewTable = document.getElementById('btnViewTable');
	const worksShowcase = document.getElementById('worksShowcase');
	const worksTableView = document.getElementById('worksTableView');
	const loadMoreWrap = document.getElementById('loadMoreWrap');
	const loadMoreBtn = document.getElementById('loadMoreBtn');
	const loadMoreLabel = document.getElementById('loadMoreLabel');

	let currentFilter = 'all';
	let currentSearch = '';
	let currentView = 'showcase';
	let isExpanded = false;

	const updateWorks = () => {
		const isFiltering = currentFilter !== 'all' || currentSearch.trim() !== '';
		let visibleShowcase = 0;
		let visibleTable = 0;

		showcaseCards.forEach((card) => {
			const tags = (card.dataset.tags || '').split(',').map((t) => t.trim());
			const title = card.dataset.title || '';
			const matchesFilter = currentFilter === 'all' || tags.includes(currentFilter);
			const matchesSearch = !currentSearch || title.includes(currentSearch) || tags.some((t) => t.toLowerCase().includes(currentSearch));
			const matches = matchesFilter && matchesSearch;

			if (matches) {
				const isExtra = card.classList.contains('work-extra');
				if (isFiltering || isExpanded || !isExtra) {
					card.style.display = 'grid';
				} else {
					card.style.display = 'none';
				}
				visibleShowcase++;
			} else {
				card.style.display = 'none';
			}
		});

		tableRows.forEach((row) => {
			const tags = (row.dataset.tags || '').split(',').map((t) => t.trim());
			const title = row.dataset.title || '';
			const matchesFilter = currentFilter === 'all' || tags.includes(currentFilter);
			const matchesSearch = !currentSearch || title.includes(currentSearch) || tags.some((t) => t.toLowerCase().includes(currentSearch));

			if (matchesFilter && matchesSearch) {
				row.style.display = '';
				visibleTable++;
			} else {
				row.style.display = 'none';
			}
		});

		const totalVisible = currentView === 'showcase' ? visibleShowcase : visibleTable;
		if (noResults) {
			noResults.style.display = totalVisible === 0 ? 'block' : 'none';
		}

		if (loadMoreWrap) {
			if (currentView === 'table' || isFiltering) {
				loadMoreWrap.style.display = 'none';
			} else {
				loadMoreWrap.style.display = 'flex';
			}
		}
	};

	filterBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			currentFilter = btn.dataset.filter ?? 'all';
			filterBtns.forEach((b) => {
				const isActive = b.dataset.filter === currentFilter;
				b.classList.toggle('active', isActive);
				b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
			});
			updateWorks();
		});
	});

	if (searchInput) {
		searchInput.addEventListener('input', () => {
			currentSearch = searchInput.value.trim().toLowerCase();
			updateWorks();
		});
	}

	if (resetBtn) {
		resetBtn.addEventListener('click', () => {
			currentFilter = 'all';
			currentSearch = '';
			if (searchInput) searchInput.value = '';
			filterBtns.forEach((b) => {
				const isActive = b.dataset.filter === 'all';
				b.classList.toggle('active', isActive);
				b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
			});
			updateWorks();
		});
	}

	if (btnViewShowcase && btnViewTable && worksShowcase && worksTableView) {
		btnViewShowcase.addEventListener('click', () => {
			currentView = 'showcase';
			btnViewShowcase.classList.add('active');
			btnViewShowcase.setAttribute('aria-pressed', 'true');
			btnViewTable.classList.remove('active');
			btnViewTable.setAttribute('aria-pressed', 'false');
			worksShowcase.style.display = 'flex';
			worksTableView.style.display = 'none';
			updateWorks();
		});

		btnViewTable.addEventListener('click', () => {
			currentView = 'table';
			btnViewTable.classList.add('active');
			btnViewTable.setAttribute('aria-pressed', 'true');
			btnViewShowcase.classList.remove('active');
			btnViewShowcase.setAttribute('aria-pressed', 'false');
			worksShowcase.style.display = 'none';
			worksTableView.style.display = 'block';
			updateWorks();
		});
	}

	if (loadMoreBtn && loadMoreLabel) {
		loadMoreBtn.addEventListener('click', () => {
			isExpanded = !isExpanded;
			if (isExpanded) {
				loadMoreLabel.textContent = 'Show less';
			} else {
				loadMoreLabel.textContent = `Show all ${showcaseCards.length} projects`;
			}
			updateWorks();
		});
	}

	// Modal Dialog Handling
	document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const modalId = btn.dataset.openModal;
			if (!modalId) return;
			const modal = document.getElementById(modalId) as HTMLDialogElement | null;
			if (modal && typeof modal.showModal === 'function') {
				modal.showModal();
				document.body.style.overflow = 'hidden';
			}
		});
	});

	document.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const modal = btn.closest('dialog') as HTMLDialogElement | null;
			if (modal) {
				modal.close();
				document.body.style.overflow = '';
			}
		});
	});

	document.querySelectorAll<HTMLDialogElement>('dialog.editorial-dialog').forEach((modal) => {
		modal.addEventListener('click', (e) => {
			const rect = modal.getBoundingClientRect();
			const inDialog =
				rect.top <= e.clientY &&
				e.clientY <= rect.top + rect.height &&
				rect.left <= e.clientX &&
				e.clientX <= rect.left + rect.width;
			if (!inDialog) {
				modal.close();
				document.body.style.overflow = '';
			}
		});
		modal.addEventListener('close', () => {
			document.body.style.overflow = '';
		});
	});

	// Email copy to clipboard
	const copyEmailBtn = document.getElementById('copyEmailBtn');
	const copyStatus = document.getElementById('copyStatus');
	if (copyEmailBtn && copyStatus) {
		copyEmailBtn.addEventListener('click', async () => {
			const email = copyEmailBtn.dataset.email;
			if (!email) return;
			try {
				await navigator.clipboard.writeText(email);
				copyStatus.textContent = 'Copied to clipboard!';
				setTimeout(() => {
					copyStatus.textContent = 'Copy Address';
				}, 2200);
			} catch {
				window.location.href = `mailto:${email}`;
			}
		});
	}

	// Live visits counter
	(async () => {
		const el = document.getElementById('visitorCounter');
		if (!el) return;
		try {
			const res = await fetch('/api/visits', { cache: 'no-store' });
			if (!res.ok) return;
			const { visits } = await res.json();
			if (typeof visits !== 'number') return;
			el.textContent = `Visitor #${String(Math.max(0, visits)).padStart(6, '0')}`;
		} catch {
			/* fallback remains */
		}
	})();
</script>
