---
import '../styles/global.css';
import { PortableText } from 'astro-portabletext';
import Icon from '../components/Icon.astro';
import {
	formatMonthYear,
	getExperiences,
	getProfile,
	getProjects,
	imageUrl,
} from '../lib/sanity';

const [profile, projects, experiences] = await Promise.all([
	getProfile(),
	getProjects(),
	getExperiences(),
]);

const name = profile?.name ?? 'Redho Arifin';
const nick = profile?.nickname ?? 'Redo';
const role = profile?.role ?? 'Backend Developer';
const year = new Date().getFullYear();

const visitorNo = String(
	(1337 + [...name + nick + role].reduce((sum, c) => sum + c.charCodeAt(0), 0)) % 100000,
).padStart(6, '0');

// Unique tags across all projects
const allTags = Array.from(
	new Set(projects.flatMap((p) => p.tags ?? []).filter(Boolean)),
).sort();

const projectUrl = (p: (typeof projects)[number]) => p.liveUrl ?? p.repoUrl ?? null;

const getDomain = (url: string | null | undefined) => {
	if (!url) return 'system.internal';
	try {
		return new URL(url).hostname;
	} catch {
		return 'system.internal';
	}
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content={`${name} — ${role}. ${profile?.tagline ?? 'Backend Developer & Systems Specialist.'}`.trim()}
		/>
		<meta property="og:title" content={`${name} — ${role}`} />
		<meta property="og:description" content={profile?.tagline ?? 'Backend Developer & Systems Specialist'} />

		<!-- Prevent Flash of Unstyled Theme -->
		<script is:inline>
			const storedTheme = localStorage.getItem('theme');
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const theme = storedTheme || (prefersDark ? 'dark' : 'light');
			document.documentElement.setAttribute('data-theme', theme);
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{`${name} — ${role}`}</title>
	</head>

	<body>
		<!-- Header / Editorial Top Bar -->
		<header class="top-nav">
			<div class="nav-wrapper">
				<a href="#" class="brand">
					<img
						src="/avatar.jpg"
						alt={`Avatar of ${name}`}
						class="brand-avatar"
						width="32"
						height="32"
					/>
					<div class="brand-text">
						<span class="brand-title">{name}</span>
						<span class="brand-sub">{role} · {profile?.location ?? 'Surabaya, ID'}</span>
					</div>
				</a>

				<div class="nav-controls">
					<nav class="nav-menu" aria-label="Page Sections">
						<a href="#projects" class="nav-anchor">Work</a>
						<a href="#experience" class="nav-anchor">Experience</a>
						<a href="#about" class="nav-anchor">About</a>
						<a href="#contact" class="nav-anchor">Contact</a>
					</nav>

					<!-- Theme Switcher -->
					<button
						type="button"
						id="themeToggle"
						class="theme-toggle"
						aria-label="Toggle dark / light theme"
						title="Toggle theme"
					>
						<span class="theme-icon sun"><Icon name="sun" size={15} /></span>
						<span class="theme-icon moon"><Icon name="moon" size={15} /></span>
					</button>
				</div>
			</div>
		</header>

		<!-- Main Layout -->
		<main class="page-body">
			<!-- Hero / Editorial Statement -->
			<section class="editorial-hero">
				<div class="hero-split">
					<div class="hero-statement">
						<h1 class="statement-headline">
							Backend developer &amp; systems specialist building reliable infrastructure, automated business tooling, and resilient web platforms.
						</h1>
						<div class="statement-sub">
							<p>
								I focus on server-side architecture, Linux production environments, and full-stack execution with Next.js &amp; TypeScript. Currently building software at Harmoni and managing server infrastructure at PT CITI PLUMB.
							</p>
						</div>
					</div>

					<div class="hero-portrait">
						<div class="portrait-frame">
							<img
								src="/avatar.jpg"
								alt={`Photo of ${name}`}
								class="portrait-img"
								width="220"
								height="220"
								loading="eager"
							/>
						</div>
						<div class="portrait-meta">
							<span class="portrait-name">{name}</span>
							<span class="portrait-handle">@redoamain</span>
						</div>
					</div>
				</div>

				<div class="hero-meta-strip">
					<div class="meta-item">
						<span class="meta-label">CURRENT ROLES</span>
						<span class="meta-val">Harmoni Software House &amp; PT CITI PLUMB</span>
					</div>
					<div class="meta-item">
						<span class="meta-label">SPECIALTY</span>
						<span class="meta-val">Linux Servers, PostgreSQL, Docker, TypeScript</span>
					</div>
					<div class="meta-item">
						<span class="meta-label">CONNECT</span>
						<div class="meta-links">
							{profile?.email && (
								<a href={`mailto:${profile.email}`} class="action-link">Email ↗</a>
							)}
							{profile?.socials?.map((s) => (
								<a href={s.url ?? '#'} target="_blank" rel="noreferrer" class="action-link">
									{s.label} ↗
								</a>
							))}
						</div>
					</div>
				</div>
			</section>

			<!-- Selected Works Section -->
			<section id="projects" class="editorial-section">
				<div class="section-topbar">
					<div class="topbar-header-row">
						<div class="topbar-left">
							<h2 class="section-title">Selected Works</h2>
							<span class="section-count">({projects.length})</span>
						</div>

						<div class="topbar-controls">
							<!-- Search Input -->
							<div class="project-search-wrap">
								<Icon name="search" size={13} />
								<input
									type="text"
									id="projectSearch"
									class="project-search-input"
									placeholder="Search project or stack..."
									aria-label="Search projects by title or technology"
								/>
							</div>

							<!-- View Mode Toggle -->
							<div class="view-toggle-group" role="group" aria-label="Project view mode">
								<button
									type="button"
									id="btnViewShowcase"
									class="view-btn active"
									aria-pressed="true"
									title="Showcase Cards View"
								>
									<Icon name="grid" size={13} />
									<span>Showcase</span>
								</button>
								<button
									type="button"
									id="btnViewTable"
									class="view-btn"
									aria-pressed="false"
									title="All Projects Table View"
								>
									<Icon name="list" size={13} />
									<span>Index Table</span>
								</button>
							</div>
						</div>
					</div>

					{/* Tag Filter Pills */}
					{allTags.length > 0 && (
						<div class="filter-capsules" role="tablist" aria-label="Filter works by technology">
							<button type="button" class="filter-btn active" data-filter="all" aria-pressed="true">
								All
							</button>
							{allTags.map((tag) => (
								<button type="button" class="filter-btn" data-filter={tag} aria-pressed="false">
									{tag}
								</button>
							))}
						</div>
					)}
				</div>

				<!-- 1. Editorial Showcase View -->
				<div class="works-showcase-view" id="worksShowcase">
					{projects.map((p, idx) => (
						<article
							class={`work-card ${idx >= 4 ? 'work-extra' : ''}`}
							data-tags={(p.tags ?? []).join(',')}
							data-title={(p.title ?? '').toLowerCase()}
							data-id={p._id}
						>
							<div class="work-card-info">
								<span class="work-kicker">0{idx + 1} · System Architecture</span>
								<h3 class="work-name">
									<button
										type="button"
										class="work-title-link"
										data-open-modal={`modal-${p._id}`}
										aria-label={`View details for ${p.title}`}
									>
										{p.title}
									</button>
								</h3>
								{p.summary && <p class="work-desc">{p.summary}</p>}

								{p.tags && p.tags.length > 0 && (
									<div class="work-tags-row">
										{p.tags.map((t) => (
											<span class="spec-tag">{t}</span>
										))}
									</div>
								)}

								<div class="work-actions">
									{p.liveUrl && (
										<a href={p.liveUrl} target="_blank" rel="noreferrer" class="action-link-btn">
											<span>Live</span>
											<Icon name="arrow-up-right" size={13} />
										</a>
									)}
									{p.repoUrl && (
										<a href={p.repoUrl} target="_blank" rel="noreferrer" class="action-link-btn">
											<span>Source</span>
											<Icon name="arrow-up-right" size={13} />
										</a>
									)}
									<button
										type="button"
										class="action-link-btn details-btn"
										data-open-modal={`modal-${p._id}`}
									>
										<span>Overview</span>
										<Icon name="info" size={13} />
									</button>
								</div>
							</div>

							<div class="work-card-preview">
								<div class="browser-mockup">
									<div class="browser-bar">
										<div class="browser-dots">
											<span class="browser-dot"></span>
											<span class="browser-dot"></span>
											<span class="browser-dot"></span>
										</div>
										<span class="browser-url">{getDomain(p.liveUrl ?? p.repoUrl)}</span>
									</div>
									<div class="browser-content">
										{p.coverImage?.asset ? (
											<img
												src={imageUrl(p.coverImage, 900) ?? ''}
												alt={p.title ?? 'Project view'}
												loading="lazy"
												class="browser-img"
											/>
										) : (
											<div class="schematic-preview">
												<div class="schematic-top">
													<Icon name="terminal" size={13} />
													<span>ENGINEERING ARCHITECTURE</span>
												</div>
												<div class="schematic-body">
													<span class="schematic-title">{p.title}</span>
													<span class="schematic-stack">{(p.tags ?? []).slice(0, 4).join(' · ')}</span>
												</div>
												<div class="schematic-footer">
													<span>READY FOR PRODUCTION</span>
												</div>
											</div>
										)}
									</div>
								</div>
							</div>
						</article>
					))}
				</div>

				<!-- Load More Button (Showcase View) -->
				{projects.length > 4 && (
					<div class="load-more-wrap" id="loadMoreWrap">
						<button type="button" id="loadMoreBtn" class="load-more-btn">
							<span id="loadMoreLabel">Show all {projects.length} projects</span>
							<Icon name="chevron-down" size={13} />
						</button>
					</div>
				)}

				<!-- 2. Table Index View (Archive for large number of projects) -->
				<div class="works-table-view" id="worksTableView" style="display: none;">
					<table class="works-table">
						<thead>
							<tr>
								<th>No.</th>
								<th>Project</th>
								<th>Technologies</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							{projects.map((p, idx) => (
								<tr
									class="table-row-item"
									data-tags={(p.tags ?? []).join(',')}
									data-title={(p.title ?? '').toLowerCase()}
								>
									<td class="table-index">0{idx + 1}</td>
									<td>
										<div class="table-proj-info">
											<button
												type="button"
												class="table-proj-name"
												data-open-modal={`modal-${p._id}`}
											>
												{p.title}
											</button>
											{p.summary && <span class="table-proj-summary">{p.summary}</span>}
										</div>
									</td>
									<td>
										<div class="work-tags-row">
											{(p.tags ?? []).slice(0, 4).map((t) => (
												<span class="spec-tag">{t}</span>
											))}
										</div>
									</td>
									<td>
										<div class="table-actions">
											{p.liveUrl && (
												<a href={p.liveUrl} target="_blank" rel="noreferrer" class="action-link-btn" title="Live Preview">
													<span>Live</span>
													<Icon name="arrow-up-right" size={11} />
												</a>
											)}
											{p.repoUrl && (
												<a href={p.repoUrl} target="_blank" rel="noreferrer" class="action-link-btn" title="Source Code">
													<span>Repo</span>
													<Icon name="arrow-up-right" size={11} />
												</a>
											)}
											<button
												type="button"
												class="action-link-btn"
												data-open-modal={`modal-${p._id}`}
												title="Project Details"
											>
												<span>Details</span>
											</button>
										</div>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>

				<!-- Filter empty state -->
				<div id="noResultsMsg" class="editorial-empty" style="display: none;">
					<p>No projects match your search or filter.</p>
					<button type="button" class="action-link" id="resetFilter">Clear filters →</button>
				</div>

				<!-- Detail Modals -->
				{projects.map((p) => (
					<dialog id={`modal-${p._id}`} class="editorial-dialog" aria-labelledby={`title-${p._id}`}>
						<div class="dialog-inner">
							<div class="dialog-top">
								<h2 class="dialog-title" id={`title-${p._id}`}>{p.title}</h2>
								<button type="button" class="dialog-close" data-close-modal aria-label="Close dialog">
									<Icon name="x" size={18} />
								</button>
							</div>

							<div class="dialog-scroll">
								{p.coverImage?.asset && (
									<div class="dialog-media-frame">
										<img
											src={imageUrl(p.coverImage, 1100) ?? ''}
											alt={p.title ?? 'Project full view'}
											class="dialog-cover-img"
										/>
									</div>
								)}

								{p.summary && <p class="dialog-lead">{p.summary}</p>}

								{p.tags && p.tags.length > 0 && (
									<div class="dialog-spec-row">
										<span class="spec-label">Technologies:</span>
										<div class="spec-pills">
											{p.tags.map((t) => (
												<span class="spec-tag">{t}</span>
											))}
										</div>
									</div>
								)}

								{p.description && p.description.length > 0 && (
									<div class="dialog-body-prose">
										<PortableText value={p.description} />
									</div>
								)}

								<div class="dialog-links-row">
									{p.liveUrl && (
										<a href={p.liveUrl} target="_blank" rel="noreferrer" class="button-solid">
											<span>Visit Live Site</span>
											<Icon name="arrow-up-right" size={14} />
										</a>
									)}
									{p.repoUrl && (
										<a href={p.repoUrl} target="_blank" rel="noreferrer" class="button-outline">
											<span>View Repository</span>
											<Icon name="arrow-up-right" size={14} />
										</a>
									)}
									<button type="button" class="button-ghost" data-close-modal>
										Close
									</button>
								</div>
							</div>
						</div>
					</dialog>
				))}
			</section>

			<!-- Experience & Background -->
			<section id="experience" class="editorial-section">
				<div class="section-topbar">
					<h2 class="section-title">Experience &amp; Roles</h2>
				</div>

				<div class="experience-table">
					{experiences.map((e) => (
						<div class="exp-row">
							<div class="exp-col-date">
								<span class="exp-time">
									{formatMonthYear(e.startDate)} — {e.current ? 'Present' : formatMonthYear(e.endDate)}
								</span>
								{e.location && <span class="exp-loc">{e.location}</span>}
							</div>

							<div class="exp-col-role">
								<h3 class="exp-position">{e.position}</h3>
								<span class="exp-company">@ {e.company}</span>
							</div>

							<div class="exp-col-summary">
								{e.summary && <p>{e.summary}</p>}
								{e.tags && e.tags.length > 0 && (
									<div class="exp-tags-list">
										{e.tags.map((t) => (
											<span class="spec-tag">{t}</span>
										))}
									</div>
								)}
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- About & Engineering Approach -->
			<section id="about" class="editorial-section">
				<div class="section-topbar">
					<h2 class="section-title">About &amp; Approach</h2>
				</div>

				<div class="about-grid">
					<div class="about-prose">
						{profile?.bio ? (
							<PortableText value={profile.bio} />
						) : (
							<p>
								I'm a full-stack web developer who combines solid server-side logic with polished frontend experiences.
								I specialize in scalable backend systems, Linux servers, and end-to-end web deployment.
							</p>
						)}
					</div>

					<div class="about-aside">
						<h3 class="aside-heading">Core Competencies</h3>
						<ul class="aside-list">
							<li>
								<strong>System Architecture</strong>
								<span>Designing data contracts, RESTful interfaces, and modular backend services.</span>
							</li>
							<li>
								<strong>Linux &amp; Server Infrastructure</strong>
								<span>Server security, Docker container orchestration, deployment automation, and process monitoring.</span>
							</li>
							<li>
								<strong>Database Engineering</strong>
								<span>Relational data modeling with PostgreSQL, indexing, query optimization, and cache management.</span>
							</li>
							<li>
								<strong>Full-Stack Frontend</strong>
								<span>Next.js, Tailwind CSS, and TypeScript for responsive, accessible user interfaces.</span>
							</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- Contact / Get in touch -->
			<section id="contact" class="editorial-section contact-section">
				<div class="section-topbar">
					<h2 class="section-title">Get in Touch</h2>
				</div>

				<div class="contact-box">
					<p class="contact-intro">
						If you have a backend infrastructure challenge, a project inquiry, or want to discuss technical collaboration, write directly:
					</p>

					{profile?.email && (
						<div class="contact-email-row">
							<a href={`mailto:${profile.email}`} class="big-email-link">
								{profile.email}
							</a>
							<button
								type="button"
								class="copy-btn"
								id="copyEmailBtn"
								data-email={profile.email}
								title="Copy email to clipboard"
							>
								<span id="copyStatus">Copy Address</span>
							</button>
						</div>
					)}

					{profile?.socials && profile.socials.length > 0 && (
						<div class="contact-social-row">
							<span class="social-caption">Elsewhere:</span>
							<div class="social-links-list">
								{profile.socials.map((s) => (
									<a href={s.url ?? '#'} target="_blank" rel="noreferrer" class="action-link">
										{s.label} ↗
									</a>
								))}
							</div>
						</div>
					)}
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="page-footer">
			<div class="footer-wrapper">
				<div class="footer-col">
					<span>{name}</span>
					<span class="footer-dot">·</span>
					<span>© {year}</span>
				</div>
				<div class="footer-col">
					<span class="footer-quiet" id="visitorCounter">Visitor #{visitorNo}</span>
				</div>
				<div class="footer-col">
					<a href="#" class="back-top-link">Back to top ↑</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<script>
	// Dark / Light Theme Toggle
	const themeBtn = document.getElementById('themeToggle');
	if (themeBtn) {
		themeBtn.addEventListener('click', () => {
			const current = document.documentElement.getAttribute('data-theme') || 'dark';
			const next = current === 'dark' ? 'light' : 'dark';
			document.documentElement.setAttribute('data-theme', next);
			localStorage.setItem('theme', next);
		});
	}

	// Project View State, Search, & Filtering
	const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const showcaseCards = document.querySelectorAll<HTMLElement>('.work-card');
	const tableRows = document.querySelectorAll<HTMLElement>('.table-row-item');
	const noResults = document.getElementById('noResultsMsg');
	const resetBtn = document.getElementById('resetFilter');
	const searchInput = document.getElementById('projectSearch') as HTMLInputElement | null;
	const btnViewShowcase = document.getElementById('btnViewShowcase');
	const btnViewTable = document.getElementById('btnViewTable');
	const worksShowcase = document.getElementById('worksShowcase');
	const worksTableView = document.getElementById('worksTableView');
	const loadMoreWrap = document.getElementById('loadMoreWrap');
	const loadMoreBtn = document.getElementById('loadMoreBtn');
	const loadMoreLabel = document.getElementById('loadMoreLabel');

	let currentFilter = 'all';
	let currentSearch = '';
	let currentView = 'showcase';
	let isExpanded = false;

	const updateWorks = () => {
		const isFiltering = currentFilter !== 'all' || currentSearch.trim() !== '';
		let visibleShowcase = 0;
		let visibleTable = 0;

		showcaseCards.forEach((card) => {
			const tags = (card.dataset.tags || '').split(',').map((t) => t.trim());
			const title = card.dataset.title || '';
			const matchesFilter = currentFilter === 'all' || tags.includes(currentFilter);
			const matchesSearch = !currentSearch || title.includes(currentSearch) || tags.some((t) => t.toLowerCase().includes(currentSearch));
			const matches = matchesFilter && matchesSearch;

			if (matches) {
				const isExtra = card.classList.contains('work-extra');
				if (isFiltering || isExpanded || !isExtra) {
					card.style.display = 'grid';
				} else {
					card.style.display = 'none';
				}
				visibleShowcase++;
			} else {
				card.style.display = 'none';
			}
		});

		tableRows.forEach((row) => {
			const tags = (row.dataset.tags || '').split(',').map((t) => t.trim());
			const title = row.dataset.title || '';
			const matchesFilter = currentFilter === 'all' || tags.includes(currentFilter);
			const matchesSearch = !currentSearch || title.includes(currentSearch) || tags.some((t) => t.toLowerCase().includes(currentSearch));

			if (matchesFilter && matchesSearch) {
				row.style.display = '';
				visibleTable++;
			} else {
				row.style.display = 'none';
			}
		});

		const totalVisible = currentView === 'showcase' ? visibleShowcase : visibleTable;
		if (noResults) {
			noResults.style.display = totalVisible === 0 ? 'block' : 'none';
		}

		if (loadMoreWrap) {
			if (currentView === 'table' || isFiltering) {
				loadMoreWrap.style.display = 'none';
			} else {
				loadMoreWrap.style.display = 'flex';
			}
		}
	};

	filterBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			currentFilter = btn.dataset.filter ?? 'all';
			filterBtns.forEach((b) => {
				const isActive = b.dataset.filter === currentFilter;
				b.classList.toggle('active', isActive);
				b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
			});
			updateWorks();
		});
	});

	if (searchInput) {
		searchInput.addEventListener('input', () => {
			currentSearch = searchInput.value.trim().toLowerCase();
			updateWorks();
		});
	}

	if (resetBtn) {
		resetBtn.addEventListener('click', () => {
			currentFilter = 'all';
			currentSearch = '';
			if (searchInput) searchInput.value = '';
			filterBtns.forEach((b) => {
				const isActive = b.dataset.filter === 'all';
				b.classList.toggle('active', isActive);
				b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
			});
			updateWorks();
		});
	}

	if (btnViewShowcase && btnViewTable && worksShowcase && worksTableView) {
		btnViewShowcase.addEventListener('click', () => {
			currentView = 'showcase';
			btnViewShowcase.classList.add('active');
			btnViewShowcase.setAttribute('aria-pressed', 'true');
			btnViewTable.classList.remove('active');
			btnViewTable.setAttribute('aria-pressed', 'false');
			worksShowcase.style.display = 'flex';
			worksTableView.style.display = 'none';
			updateWorks();
		});

		btnViewTable.addEventListener('click', () => {
			currentView = 'table';
			btnViewTable.classList.add('active');
			btnViewTable.setAttribute('aria-pressed', 'true');
			btnViewShowcase.classList.remove('active');
			btnViewShowcase.setAttribute('aria-pressed', 'false');
			worksShowcase.style.display = 'none';
			worksTableView.style.display = 'block';
			updateWorks();
		});
	}

	if (loadMoreBtn && loadMoreLabel) {
		loadMoreBtn.addEventListener('click', () => {
			isExpanded = !isExpanded;
			if (isExpanded) {
				loadMoreLabel.textContent = 'Show less';
			} else {
				loadMoreLabel.textContent = `Show all ${showcaseCards.length} projects`;
			}
			updateWorks();
		});
	}

	// Modal Dialog Handling
	document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const modalId = btn.dataset.openModal;
			if (!modalId) return;
			const modal = document.getElementById(modalId) as HTMLDialogElement | null;
			if (modal && typeof modal.showModal === 'function') {
				modal.showModal();
				document.body.style.overflow = 'hidden';
			}
		});
	});

	document.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const modal = btn.closest('dialog') as HTMLDialogElement | null;
			if (modal) {
				modal.close();
				document.body.style.overflow = '';
			}
		});
	});

	document.querySelectorAll<HTMLDialogElement>('dialog.editorial-dialog').forEach((modal) => {
		modal.addEventListener('click', (e) => {
			const rect = modal.getBoundingClientRect();
			const inDialog =
				rect.top <= e.clientY &&
				e.clientY <= rect.top + rect.height &&
				rect.left <= e.clientX &&
				e.clientX <= rect.left + rect.width;
			if (!inDialog) {
				modal.close();
				document.body.style.overflow = '';
			}
		});
		modal.addEventListener('close', () => {
			document.body.style.overflow = '';
		});
	});

	// Email copy to clipboard
	const copyEmailBtn = document.getElementById('copyEmailBtn');
	const copyStatus = document.getElementById('copyStatus');
	if (copyEmailBtn && copyStatus) {
		copyEmailBtn.addEventListener('click', async () => {
			const email = copyEmailBtn.dataset.email;
			if (!email) return;
			try {
				await navigator.clipboard.writeText(email);
				copyStatus.textContent = 'Copied to clipboard!';
				setTimeout(() => {
					copyStatus.textContent = 'Copy Address';
				}, 2200);
			} catch {
				window.location.href = `mailto:${email}`;
			}
		});
	}

	// Live visits counter
	(async () => {
		const el = document.getElementById('visitorCounter');
		if (!el) return;
		try {
			const res = await fetch('/api/visits', { cache: 'no-store' });
			if (!res.ok) return;
			const { visits } = await res.json();
			if (typeof visits !== 'number') return;
			el.textContent = `Visitor #${String(Math.max(0, visits)).padStart(6, '0')}`;
		} catch {
			/* fallback remains */
		}
	})();
</script>