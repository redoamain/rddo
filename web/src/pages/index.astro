---
import '../styles/global.css';
import { PortableText } from 'astro-portabletext';
import Icon from '../components/Icon.astro';
import {
	formatMonthYear,
	getExperiences,
	getProfile,
	getProjects,
	imageUrl,
} from '../lib/sanity';

const [profile, projects, experiences] = await Promise.all([
	getProfile(),
	getProjects(),
	getExperiences(),
]);

const name = profile?.name ?? 'Redho Arifin';
const nick = profile?.nickname ?? 'Redo';
const role = profile?.role ?? 'Programmer';
const year = new Date().getFullYear();

const visitorNo = String(
	(1337 + [...name + nick + role].reduce((sum, c) => sum + c.charCodeAt(0), 0)) % 100000,
).padStart(6, '0');
// Fallback saat /api/visits belum tersedia (mis. astro dev lokal).
// Di production (Vercel), angka ini langsung diganti hasil fetch real-time.

// Unique tags across all projects for retro filter toolbar
const allTags = Array.from(
	new Set(projects.flatMap((p) => p.tags ?? []).filter(Boolean)),
).sort();
const projectUrl = (p: (typeof projects)[number]) => p.liveUrl ?? p.repoUrl ?? null;

// brand icon name for social links
const socialIcon = (label: string | null | undefined): string => {
	const l = (label ?? '').toLowerCase();
	if (l.includes('github')) return 'github';
	if (l.includes('linkedin')) return 'linkedin';
	if (l.includes('twitter') || l.includes('x')) return 'twitter';
	if (l.includes('instagram')) return 'instagram';
	if (l.includes('facebook')) return 'facebook';
	if (l.includes('youtube')) return 'youtube';
	return 'globe';
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content={`Personal homepage of ${name} (${nick}) — ${role}. ${profile?.tagline ?? ''}`.trim()}
		/>
		<meta property="og:title" content={`${name}'s Homepage`} />
		<title>{`${name} (${nick}) — Homepage`}</title>
	</head>

	<body>
		<div class="win">
			{/* ---------- window title bar ---------- */}
			<div class="win-titlebar">
				<span class="win-icon" aria-hidden="true"></span>
				<span>{nick} — Homepage</span>
			</div>

			{/* ---------- marquee ---------- */}
			<div class="marquee" aria-hidden="true">
				<div class="marquee-track">
					<span>✦ Welcome to {nick}'s homepage ✦ </span>
					<span>✦ Welcome to {nick}'s homepage ✦ </span>
					<span>✦ Welcome to {nick}'s homepage ✦ </span>
					<span>✦ Welcome to {nick}'s homepage ✦ </span>
				</div>
			</div>

		{/* ---------- hero ---------- */}
<header class="hero">
	{
		profile?.avatar?.asset ? (
			<div class="avatar-wrap">
				<img
					src={imageUrl(profile.avatar, 260) ?? ''}
					alt={`Photo of ${name}`}
					class="avatar-frame"
					width="130"
					height="130"
				/>
			</div>
		) : (
			<div class="no-photo">{name.slice(0, 1)}</div>
		)
	}
	<h1>{name}</h1>
	<p class="aka">
		a.k.a. <b>{nick}</b> — {role}
	</p>
	{profile?.tagline && <p class="tagline">{profile.tagline}</p>}

{/* Visitor Counter dengan efek rolling */}
{/* Visitor counter dengan tema monochrome */}
<div class="counter-line">
	<span>You are visitor number</span>
	<div class="counter" id="visitorCounter" aria-label={`Visitor number ${visitorNo}`}>
		{visitorNo.split('').map((d) => (
			<i>{d}</i>
		))}
	</div>
</div>

	{/* Tambahan counter style LCD (opsional) */}
	{/* <div class="counter-line">
		<span>👤 Visitor #</span>
		<div class="counter-lcd">
			{visitorNo.split('').map((d, index) => (
				<i key={index}>{d}</i>
			))}
		</div>
	</div> */}
</header>
			{/* ---------- menu dengan hamburger untuk mobile ---------- */}
			<nav class="menu" aria-label="Main menu">
				<button class="menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false">
					<span class="menu-toggle-icon">☰</span>
					<span class="menu-toggle-text">Menu</span>
				</button>
				<ul class="menu-list" id="menuList">
					<li><a href="#about"><Icon name="user" size={13} /> About</a></li>
					<li><a href="#projects"><Icon name="folder" size={13} /> Projects</a></li>
					<li><a href="#experience"><Icon name="briefcase" size={13} /> Experience</a></li>
					<li><a href="#contact"><Icon name="mail" size={13} /> Contact</a></li>
				</ul>
			</nav>

			{/* ---------- ABOUT ---------- */}
			<section id="about" class="rbox">
				<div class="rbox-bar">
					<span class="rbox-ico"><Icon name="user" size={15} /></span>
					<span>About Me</span>
				</div>
				<div class="rbox-body">
					<div class="pt-content">
						{profile?.bio ? (
							<PortableText value={profile.bio} />
						) : (
							<p class="empty-note">(No bio yet — edit it in Sanity Studio.)</p>
						)}
					</div>
					<div class="contact-meta">
						{profile?.location && (
							<span class="meta-item">
								<Icon name="map-pin" size={13} />
								{profile.location}
							</span>
						)}
						{profile?.email && (
							<span class="meta-item">
								<Icon name="mail" size={13} />
								<a href={`mailto:${profile.email}`}>{profile.email}</a>
							</span>
						)}
					</div>
				</div>
			</section>

			{/* ---------- PROJECTS ---------- */}
			<section id="projects" class="rbox">
				<div class="rbox-bar">
					<span class="rbox-ico"><Icon name="folder" size={15} /></span>
					<span>Projects ({projects.length})</span>
				</div>
				<div class="rbox-body">
					{projects.length === 0 && <p class="empty-note">No projects to show yet.</p>}

					{projects.length > 0 && (
						<div class="proj-container">
							{/* Retro Toolbar */}
							<div class="proj-toolbar">
								<div class="proj-toolbar-header">
									<span class="proj-status">
										<Icon name="terminal" size={12} /> DIRECTORY: /PROJECTS
									</span>
									<span class="proj-counter-badge" id="projVisibleCount">
										Showing {projects.length} of {projects.length}
									</span>
								</div>
								{allTags.length > 0 && (
									<div class="proj-filter-row">
										<span class="filter-label">
											<Icon name="tag" size={12} /> FILTER:
										</span>
										<div class="filter-pills" role="tablist" aria-label="Filter projects by tag">
											<button
												type="button"
												class="filter-btn active"
												data-filter="all"
												aria-pressed="true"
											>
												ALL <span class="tag-count">[{projects.length}]</span>
											</button>
											{allTags.map((tag) => {
												const count = projects.filter((p) => p.tags?.includes(tag)).length;
												return (
													<button
														type="button"
														class="filter-btn"
														data-filter={tag}
														aria-pressed="false"
													>
														{tag} <span class="tag-count">[{count}]</span>
													</button>
												);
											})}
										</div>
									</div>
								)}
							</div>

							{/* Projects Grid */}
							<div class="proj-grid" id="projGrid">
								{projects.map((p, idx) => (
									<article
										class="proj-card"
										data-tags={(p.tags ?? []).join(',')}
										data-id={p._id}
									>
										<div class="proj-card-header">
											<div class="proj-card-dots">
												<span class="dot" aria-hidden="true"></span>
												<span class="proj-card-id">
													PROJ_{String(idx + 1).padStart(2, '0')}.APP
												</span>
											</div>
											{p.liveUrl ? (
												<span class="status-indicator live">● ONLINE</span>
											) : p.repoUrl ? (
												<span class="status-indicator repo">● REPO</span>
											) : (
												<span class="status-indicator idle">● ARCHIVE</span>
											)}
										</div>

										<div class="proj-img-wrap">
											{p.coverImage?.asset ? (
												<a
													href={projectUrl(p) ?? '#'}
													target="_blank"
													rel="noreferrer"
													class="proj-img-link"
													tabindex="-1"
													aria-label={`Open preview for ${p.title}`}
												>
													<img
														src={imageUrl(p.coverImage, 700) ?? ''}
														alt={p.title ?? 'Project preview'}
														loading="lazy"
													/>
												</a>
											) : (
												<div class="no-img">
													<Icon name="code" size={24} />
													<span>NO PREVIEW</span>
												</div>
											)}
										</div>

										<div class="proj-body">
											<h3 class="proj-title">
												<button
													type="button"
													class="proj-title-btn"
													data-open-modal={`modal-${p._id}`}
													aria-label={`View details for ${p.title}`}
												>
													{p.title}
												</button>
											</h3>

											{p.summary && <p class="proj-summary">{p.summary}</p>}

											{p.tags && p.tags.length > 0 && (
												<ul class="proj-tags" aria-label="Project technologies">
													{p.tags.map((t) => (
														<li>
															<Icon name="tag" size={10} /> {t}
														</li>
													))}
												</ul>
											)}

											<div class="proj-links">
												{p.liveUrl && (
													<a
														href={p.liveUrl}
														target="_blank"
														rel="noreferrer"
														class="proj-btn proj-btn-primary"
													>
														<Icon name="external-link" size={12} /> Live
													</a>
												)}
												{p.repoUrl && (
													<a
														href={p.repoUrl}
														target="_blank"
														rel="noreferrer"
														class="proj-btn"
													>
														<Icon name="code" size={12} /> Source
													</a>
												)}
												<button
													type="button"
													class="proj-btn proj-btn-details"
													data-open-modal={`modal-${p._id}`}
													aria-label={`Details for ${p.title}`}
												>
													<Icon name="info" size={12} /> Details
												</button>
											</div>
										</div>
									</article>
								))}
							</div>

							{/* Empty state when no filter matches */}
							<div id="projNoResults" class="proj-empty-state" style="display: none;">
								<Icon name="terminal" size={22} />
								<p>No projects match the selected filter.</p>
								<button type="button" class="proj-btn" id="resetFilterBtn">
									Reset Filter
								</button>
							</div>

							{/* Retro Dialogs for Project Details */}
							{projects.map((p) => (
								<dialog id={`modal-${p._id}`} class="retro-dialog" aria-labelledby={`modal-title-${p._id}`}>
									<div class="retro-dialog-titlebar">
										<div class="retro-dialog-title" id={`modal-title-${p._id}`}>
											<Icon name="folder" size={13} />
											<span>PROPERTIES — {p.title}</span>
										</div>
										<button
											type="button"
											class="retro-dialog-close"
											data-close-modal
											aria-label="Close dialog"
										>
											<Icon name="x" size={12} />
										</button>
									</div>

									<div class="retro-dialog-body">
										{p.coverImage?.asset && (
											<img
												src={imageUrl(p.coverImage, 900) ?? ''}
												alt={p.title ?? 'Project cover'}
												class="retro-dialog-img"
											/>
										)}

										<h2 class="retro-dialog-title-h2">{p.title}</h2>

										{p.summary && <p class="retro-dialog-summary">{p.summary}</p>}

										{p.tags && p.tags.length > 0 && (
											<div class="retro-dialog-meta">
												<span class="meta-label">Tags:</span>
												<ul class="proj-tags" style="display: inline-flex; margin: 0;">
													{p.tags.map((t) => (
														<li>
															<Icon name="tag" size={10} /> {t}
														</li>
													))}
												</ul>
											</div>
										)}

										{p.description && p.description.length > 0 ? (
											<div class="retro-dialog-desc pt-content">
												<PortableText value={p.description} />
											</div>
										) : (
											<p class="empty-note">No additional description available.</p>
										)}

										<div class="retro-dialog-actions">
											{p.liveUrl && (
												<a
													href={p.liveUrl}
													target="_blank"
													rel="noreferrer"
													class="proj-btn proj-btn-primary"
												>
													<Icon name="external-link" size={13} /> Visit Live Demo
												</a>
											)}
											{p.repoUrl && (
												<a
													href={p.repoUrl}
													target="_blank"
													rel="noreferrer"
													class="proj-btn"
												>
													<Icon name="code" size={13} /> View Source Code
												</a>
											)}
											<button
												type="button"
												class="proj-btn"
												data-close-modal
											>
												<Icon name="x" size={13} /> Close Window
											</button>
										</div>
									</div>
								</dialog>
							))}
						</div>
					)}
				</div>
			</section>

			{/* ---------- EXPERIENCE ---------- */}
			<section id="experience" class="rbox">
				<div class="rbox-bar">
					<span class="rbox-ico"><Icon name="briefcase" size={15} /></span>
					<span>Work Experience</span>
				</div>
				<div class="rbox-body">
					{experiences.length === 0 && <p class="empty-note">No work experience yet.</p>}
					<ul class="exp-list">
						{experiences.map((e) => (
							<li class="exp-item">
								<div class="exp-date">
									{formatMonthYear(e.startDate)}
									{' – '}
									{e.current ? <span class="now">Present</span> : formatMonthYear(e.endDate)}
								</div>
								<div class="exp-main">
									<h3>
										{e.position} <span class="at">@ {e.company}</span>
									</h3>
									{e.location && (
										<div class="loc">
											<Icon name="map-pin" size={11} /> {e.location}
										</div>
									)}
									{e.summary && <p>{e.summary}</p>}
									{e.tags && e.tags.length > 0 && (
										<ul class="exp-tags">
											{e.tags.map((t) => <li>{t}</li>)}
										</ul>
									)}
								</div>
							</li>
						))}
					</ul>
				</div>
			</section>

			{/* ---------- CONTACT / GUESTBOOK ---------- */}
			<section id="contact" class="rbox">
				<div class="rbox-bar">
					<span class="rbox-ico"><Icon name="mail" size={15} /></span>
					<span>Guestbook &amp; Contact</span>
				</div>
				<div class="rbox-body">
					<p>Want to work together or just say hello? Drop a message anytime.</p>
					<div class="guestbook-actions">
						{profile?.email && (
							<a class="xbtn" href={`mailto:${profile.email}?subject=Hello ${nick}!`}>
								<Icon name="pen-line" size={14} /> Send a message
							</a>
						)}
						{profile?.socials && profile.socials.length > 0 && (
							<div class="social-links">
								{profile.socials.map((s) => (
									<a href={s.url ?? '#'} target="_blank" rel="noreferrer">
										<Icon name={socialIcon(s.label)} size={14} /> {s.label}
									</a>
								))}
							</div>
						)}
					</div>
					{profile?.email && (
						<p class="email-big">
							email : <a href={`mailto:${profile.email}`}>{profile.email}</a>
						</p>
					)}
				</div>
			</section>

			{/* ---------- footer ---------- */}
			<footer class="footer">
				<p class="footer-copy">
					&copy; 2002–{year} {name} ({nick}) — Powered by Astro + Sanity
				</p>
				<p class="footer-copy">
					<a class="to-top" href="#top">
						<Icon name="arrow-up" size={12} /> Back to top
					</a>
				</p>
				<p class="footer-copy" style="font-size: 11px; opacity: 0.7; margin-top: 6px;">
					Best viewed with Netscape Navigator 4.0 or Internet Explorer 5.0
				</p>
			</footer>
		</div>
	</body>
</html>

<script>
	// Mobile menu toggle
	const menuToggle = document.getElementById('menuToggle');
	const menuList = document.getElementById('menuList');

	if (menuToggle && menuList) {
		menuToggle.addEventListener('click', () => {
			const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
			menuToggle.setAttribute('aria-expanded', !isExpanded);
			menuList.classList.toggle('menu-open');
		});

		// Close menu when a link is clicked (on mobile)
		menuList.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', () => {
				menuToggle.setAttribute('aria-expanded', 'false');
				menuList.classList.remove('menu-open');
			});
		});
	}

	// Retro Filter for the Projects section
	const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const projectCards = document.querySelectorAll<HTMLElement>('.proj-card');
	const counterBadge = document.getElementById('projVisibleCount');
	const noResults = document.getElementById('projNoResults');
	const resetBtn = document.getElementById('resetFilterBtn');

	const applyFilter = (filter: string) => {
		filterButtons.forEach((btn) => {
			const isActive = btn.dataset.filter === filter;
			btn.classList.toggle('active', isActive);
			btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
		});

		let visibleCount = 0;
		projectCards.forEach((card) => {
			const rawTags = card.dataset.tags || '';
			const tags = rawTags.split(',').map((t) => t.trim());
			const isMatch = filter === 'all' || tags.includes(filter);
			if (isMatch) {
				card.style.display = 'flex';
				visibleCount++;
			} else {
				card.style.display = 'none';
			}
		});

		if (counterBadge) {
			counterBadge.textContent = `Showing ${visibleCount} of ${projectCards.length}`;
		}
		if (noResults) {
			noResults.style.display = visibleCount === 0 ? 'block' : 'none';
		}
	};

	filterButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const filter = btn.dataset.filter ?? 'all';
			applyFilter(filter);
		});
	});

	if (resetBtn) {
		resetBtn.addEventListener('click', () => {
			applyFilter('all');
		});
	}

	// Retro Modal Dialogs for Project Details
	document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const modalId = btn.dataset.openModal;
			if (!modalId) return;
			const modal = document.getElementById(modalId) as HTMLDialogElement | null;
			if (modal && typeof modal.showModal === 'function') {
				modal.showModal();
				document.body.style.overflow = 'hidden';
			}
		});
	});

	document.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const modal = btn.closest('dialog') as HTMLDialogElement | null;
			if (modal) {
				modal.close();
				document.body.style.overflow = '';
			}
		});
	});

	document.querySelectorAll<HTMLDialogElement>('dialog.retro-dialog').forEach((modal) => {
		// Close on backdrop click
		modal.addEventListener('click', (e) => {
			const rect = modal.getBoundingClientRect();
			const isInDialog =
				rect.top <= e.clientY &&
				e.clientY <= rect.top + rect.height &&
				rect.left <= e.clientX &&
				e.clientX <= rect.left + rect.width;
			if (!isInDialog) {
				modal.close();
				document.body.style.overflow = '';
			}
		});
		modal.addEventListener('close', () => {
			document.body.style.overflow = '';
		});
	});

	// Real visitor counter — tiap page load / refresh = +1.
	// GET /api/visits (Vercel Function) increment atomik di Sanity `siteStats`.
	// Gagal (mis. astro dev lokal tanpa function) → biarkan angka fallback.
	(async () => {
		const el = document.getElementById('visitorCounter');
		if (!el) return;
		try {
			const res = await fetch('/api/visits', { cache: 'no-store' });
			if (!res.ok) return;
			const { visits } = await res.json();
			if (typeof visits !== 'number') return;
			const digits = String(Math.max(0, visits)).padStart(6, '0').split('');
			el.setAttribute('aria-label', `Visitor number ${digits.join('')}`);
			el.innerHTML = '';
			digits.forEach((d, i) => {
				const cell = document.createElement('i');
				// Digit "berjatuhan" satu per satu ala rolling counter retro.
				setTimeout(() => {
					cell.textContent = d;
					el.appendChild(cell);
				}, 90 * i);
			});
		} catch {
			/* abaikan — tampilkan fallback */
		}
	})();
</script>