PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Server-only, dipakai Vercel Function api/visits.js (visitor counter).
# JANGAN pakai prefix PUBLIC_ agar tidak terbundle ke browser.
# Isi di Vercel → Settings → Environment Variables. Jangan commit file .env asli.
# Token dibuat di manage.sanity.io → project → API → Tokens (role Editor).
SANITY_API_TOKEN=
